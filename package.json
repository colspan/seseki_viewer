{
  "name": "seseki_viewer",
  "version": "3.0.0",
  "description": "A Statistics Viewer for generating geometry heatmaps and rankings.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build_production": "npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:prefecture-geojson": "node misc/generate_prefecture_geojson.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colspan/seseki_viewer.git"
  },
  "author": "Kunihiko Miyoshi @colspan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colspan/seseki_viewer/issues"
  },
  "homepage": "https://github.com/colspan/seseki_viewer#readme",
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "encoding-japanese": "^2.4.0",
    "leaflet": "^1.9.4",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-data-grid": "^7.0.0-beta.62",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
